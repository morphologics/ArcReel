{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {
    "name": "Generic Image Submit + Poll",
    "author": "ArcReel",
    "version": "1.0.0",
    "description": "Skeleton for an image protocol with OpenAI-style paths and async task semantics: submit to get a task_id, poll status by task_id, then read the image URL on success. Reference images are optional, so the same definition serves both text-to-image and image-to-image. Replace each field name and value path according to the provider's documentation."
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "inputs": {
    "reference_images": {
      "source": "reference_images",
      "encoding": "data_uri"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/v1/images/generations",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}",
      "size": "{{ aspect_ratio }}",
      "resolution": "{{ resolution }}",
      "n": 1,
      "image_urls": [
        {
          "$each": {
            "in": "inputs.reference_images",
            "as": "image",
            "item": "{{ image }}"
          }
        }
      ]
    },
    "extract": {
      "task_id": ["$.data[0].task_id", "$.task_id"],
      "error": ["$.error.message", "$.message"]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/v1/tasks/{{ task_id }}",
    "extract": {
      "status": ["$.data.status"],
      "image_url": ["$.data.result.images[0].url[0]"],
      "error": ["$.data.error.message", "$.error.message"]
    }
  },
  "status_map": {
    "pending": "queued",
    "submitted": "queued",
    "processing": "running",
    "completed": "succeeded",
    "failed": "failed",
    "cancelled": "failed"
  },
  "capabilities": {
    "text_to_image": true,
    "image_to_image": true,
    "max_reference_images": 4
  }
}
